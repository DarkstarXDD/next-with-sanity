{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --path=./src/sanity/extract.json && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/client": "7.22.0",
    "@sanity/icons": "3.7.4",
    "@sanity/image-url": "2",
    "@sanity/vision": "5",
    "next": "16.2.4",
    "next-sanity": "12.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sanity": "5",
    "styled-components": "6"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.5",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "clsx": "2.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-perfectionist": "5.9.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1"
  }
}
